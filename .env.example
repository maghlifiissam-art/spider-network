# Bullet Spider is offline by default and requires no secret.
BULLET_MODE=offline
BULLET_MAX_OPPORTUNITIES=5
# Enable a public/authorized aggregate adapter only after implementing its terms,
# throttling, provenance, and challenge-stop behavior. Never commit credentials.
BULLET_ENABLED_ADAPTERS=offline_fixture

# Publish Spider (social publishing via official APIs) - names only, never real values.
# Follow each platform setup guide. Meta: README_META_SETUP.md; private secret files, no .env append.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Facebook: nonsecret Page-ID -> secret-variable-name mapping; never put tokens in the JSON.
META_PAGE_TOKEN_ENV_MAP={}
META_BRAND_A_PAGE_TOKEN=
META_BRAND_B_PAGE_TOKEN=
# Legacy token below is Instagram-only; never a Facebook fallback.
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
