{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spider-network.local/schemas/bullet_production_brief.schema.json",
  "title": "Bullet Spider Production Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_id", "opportunity_id", "title", "response_type", "category", "geography", "deliverables", "assigned_spiders", "source_urls", "observed_at", "review_gates", "seo_draft", "listing_draft", "pricing_draft", "status", "limitations"],
  "properties": {
    "brief_id": {"type": "string"}, "opportunity_id": {"type": "string"}, "title": {"type": "string"},
    "response_type": {"type": "string"}, "category": {"enum": ["affiliate", "digital_product", "digital_book", "product_design", "decor_art"]}, "geography": {"type": "string"},
    "target_language": {"type": ["string", "null"]},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "assigned_spiders": {"type": "array", "items": {"type": "string"}},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "review_gates": {"type": "array", "items": {"type": "string"}},
    "seo_draft": {"type": "object"}, "listing_draft": {"type": "object"}, "pricing_draft": {"type": "object"},
    "status": {"const": "draft_requires_human_approval"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
